<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("Top Asia | Nhà Sản Xuất Polycarbonate #1 Việt Nam") }}</title>
    <meta name="description" content="{{ description | default('Top Asia sản xuất, phân phối tấm nhựa Polycarbonate cường lực, mái lấy sáng chống UV chuẩn ISO. Báo giá trực tiếp từ nhà máy.') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/styles.css">
    
    <!-- Netlify Identity Widget for CMS -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    {% if customSchema %}
    <script type="application/ld+json">
    {{ customSchema | safe }}
    </script>
    {% endif %}
</head>
<body>
    <!-- Cursor Glow -->
    <div class="cursor-glow" id="cursorGlow"></div>

    <!-- Preloader -->
    <div class="preloader" id="preloader">
        <div class="preloader-inner">
            <div class="preloader-logo">
                <img src="/images/logo.png" alt="Top Asia Logo">
            </div>
            <div class="preloader-bar"><div class="preloader-fill"></div></div>
            <p class="preloader-text">Đang tải...</p>
        </div>
    </div>

    <!-- Noise Texture Overlay -->
    <div class="noise-overlay"></div>

    <!-- Top Bar -->
    <div class="top-bar" id="topBar">
        <div class="container">
            <div class="top-bar-left">
                <span class="top-bar-item"><i class="fas fa-phone-alt"></i> <a href="tel:0896699996">0896 699 996</a></span>
                <span class="top-bar-divider"></span>
                <span class="top-bar-item"><i class="fas fa-envelope"></i> <a href="mailto:topasiaplastic@gmail.com">topasiaplastic@gmail.com</a></span>
            </div>
            <div class="top-bar-right">
                <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="#" aria-label="Youtube"><i class="fab fa-youtube"></i></a>
                <a href="#" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
            </div>
        </div>
    </div>

    <!-- Header -->
    <header class="header" id="header">
        <div class="container">
            <a href="/" class="logo" id="logo">
                <img src="/images/logo.png" alt="Top Asia Logo" class="logo-img">
            </a>

            <nav class="nav" id="nav">
                <ul class="nav-list">
                    <li><a href="/" class="nav-link">Trang Chủ</a></li>
                    <li><a href="/about.html" class="nav-link">Giới thiệu</a></li>
                    <li class="has-dropdown">
                        <a href="/products.html" class="nav-link">Sản phẩm <i class="fas fa-chevron-down"></i></a>
                        <div class="mega-dropdown">
                            <div class="mega-col">
                                <h4><i class="fas fa-gem"></i> Polycarbonate Cường Lực</h4>
                                <a href="/product-asia-lite.html">Asia Lite – LUXURY</a>
                                <a href="/product-asia-pearl.html">Asia Pearl – DELUXE</a>
                                <a href="/product-asia-gold.html">Asia Gold – Phổ thông</a>
                            </div>
                            <div class="mega-col">
                                <h4><i class="fas fa-tools"></i> Phụ kiện & Mái che</h4>
                                <a href="/product-dac-san.html">Polycarbonate Đặc Sần</a>
                                <a href="/product-phu-kien.html">Phụ kiện thi công</a>
                                <a href="/product-canopy.html">Mái che Canopy</a>
                            </div>
                        </div>
                    </li>
                    <li><a href="/projects.html" class="nav-link">Dự án</a></li>
                    <li><a href="/news.html" class="nav-link">Tin tức</a></li>
                    <li><a href="/contact.html" class="nav-link">Liên hệ</a></li>
                </ul>
            </nav>

            <div class="header-right">
                <a href="tel:0896699996" class="header-cta">
                    <span class="cta-pulse"></span>
                    <i class="fas fa-phone-alt"></i>
                    <span class="cta-text">Báo giá ngay</span>
                </a>
                <button class="hamburger" id="hamburger" aria-label="Menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <main>
        {{ content | safe }}
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="footer" id="contact">
        <div class="footer-top">
            <div class="container">
                <div class="footer-grid">
                    <div class="footer-col fc-about">
                        <a href="/" class="footer-logo">
                            <img src="/images/logo.png" alt="Top Asia Logo" class="logo-img footer-logo-img">
                        </a>
                        <p>Công ty Cổ phần Đầu tư và Sản xuất Top Asia – Nhà sản xuất tấm nhựa Polycarbonate cường lực hàng đầu Việt Nam.</p>
                        <div class="footer-contacts">
                            <div class="fc-item"><i class="fas fa-map-marker-alt"></i><span>LK65 - KĐT Dương Nội, P. Dương Nội, Q. Hà Đông, Hà Nội</span></div>
                            <div class="fc-item"><i class="fas fa-industry"></i><span>Số 702 KCN Hoàng Gia, X. Mỹ Hạnh Nam, H. Đức Hòa, Long An</span></div>
                            <div class="fc-item"><i class="fas fa-phone-alt"></i><a href="tel:0896699996">0896 699 996</a></div>
                            <div class="fc-item"><i class="fas fa-envelope"></i><a href="mailto:topasiaplastic@gmail.com">topasiaplastic@gmail.com</a></div>
                        </div>
                    </div>
                    <div class="footer-col">
                        <h4>Điều hướng</h4>
                        <ul>
                            <li><a href="/">Trang chủ</a></li>
                            <li><a href="/about.html">Giới thiệu</a></li>
                            <li><a href="/products.html">Sản phẩm</a></li>
                            <li><a href="/projects.html">Dự án</a></li>
                            <li><a href="/contact.html">Liên hệ</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Chính sách</h4>
                        <ul>
                            <li><a href="#">Chính sách bảo mật</a></li>
                            <li><a href="#">Chính sách bảo hành</a></li>
                            <li><a href="#">Chính sách giao hàng</a></li>
                            <li><a href="#">Điều khoản sử dụng</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Kết nối</h4>
                        <div class="footer-socials">
                            <a href="#" class="fs-link fb"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="fs-link yt"><i class="fab fa-youtube"></i></a>
                            <a href="#" class="fs-link tt"><i class="fab fa-tiktok"></i></a>
                            <a href="#" class="fs-link zl"><i class="fas fa-comment-dots"></i></a>
                        </div>
                        <h4>Nhận tin mới</h4>
                        <form class="footer-form" onsubmit="return false">
                            <input type="email" placeholder="Email của bạn...">
                            <button type="submit"><i class="fas fa-paper-plane"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p>© 2024 Top Asia Vietnam. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Back to Top -->
    <button class="btt" id="btt" aria-label="Về đầu trang">
        <svg viewBox="0 0 46 46"><circle cx="23" cy="23" r="21" fill="none" stroke="currentColor" stroke-width="2" class="btt-progress"/></svg>
        <i class="fas fa-arrow-up"></i>
    </button>

    <!-- Floating -->
    <div class="floating">
        <a href="tel:0896699996" class="float-phone" aria-label="Gọi điện">
            <i class="fas fa-phone-alt"></i>
        </a>
        <a href="#" class="float-zalo" aria-label="Zalo">
            <span>Zalo</span>
        </a>
    </div>

    <script src="/script.js"></script>
    <script>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", user => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
</body>
</html>
